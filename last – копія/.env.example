# Шаблон змінних оточення. Скопіюйте в .env і заповніть. .env у git НЕ комітиться.
# Повний опис кожної змінної: docs/isd.md §3.

# --- PostgreSQL (docker compose, сервіс db) ---
POSTGRES_DB=wholesale_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# --- Flask ---
SECRET_KEY=your_secret_key_here
# FLASK_DEBUG=1                # лише для локальної розробки

# --- Підключення до БД (для запуску без Docker; у compose задається автоматично) ---
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/wholesale_db
# DB_CONNECT_TIMEOUT=2
# DB_RETRY_ATTEMPTS=3
# DB_RETRY_BASE_DELAY=0.1
# DB_RETRY_MAX_DELAY=1.0

# --- Сповіщення про залишки (/api/stock-alerts) ---
# STOCK_ALERT_THRESHOLD=10

# --- Логування ---
# LOG_LEVEL=INFO
# LOG_FORMAT=text              # json у production

# --- Демо ЛР3 (secrets_trap.py) ---
GITHUB_TOKEN=
